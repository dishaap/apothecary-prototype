/* TodoButton — a small persistent HUD launcher that opens the to-do list panel.
   Rendered on the base PanelSettings (Sort Order 0), pinned to the top-right.
   All tokens come from Global.uss. */

.todo-launcher {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Positioning only — the banner background, sizing and hover/active states come
   from the shared .btn-banner class in Global.uss. */
.todo-launcher__btn {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
}
