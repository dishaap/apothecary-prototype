/* PlaylistsScreen — full-screen modal that presents the playlist library on a
   parchment scroll. Renders on the dedicated modal PanelSettings (Sort Order
   10) above the base game UI. All tokens come from Global.uss. */

.playlists {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-scrim);
    opacity: 1;
    visibility: visible;
    transition: opacity 0.28s ease-out 0s;
}

/* Closed state: fully transparent and non-interactive. visibility (unlike
   display) keeps the element laid out, so the fade/slide transitions play on
   open; it applies instantly on close and still blocks pointer input. */
.playlists--hidden {
    opacity: 0;
    visibility: hidden;
}

.playlists__panel {
    width: var(--playlists-panel-width);
    height: var(--playlists-panel-height);
    flex-direction: column;
    align-items: flex-start;
    padding-top: var(--playlists-panel-pad-top);
    padding-left: var(--playlists-panel-pad-x);
    padding-right: var(--playlists-panel-pad-x);
    padding-bottom: var(--playlists-panel-pad-bottom);
    background-image: url("project://database/Assets/UI/Images/Music%20Player/Panels/PaperPanel_BG.png?fileID=21300000&guid=824edfa5333c2634e8ead8218d245836&type=3#PaperPanel_BG");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-top: 160;
    -unity-slice-bottom: 130;
    -unity-slice-scale: 0.5px;
    translate: 0 0;
    transition: translate 0.28s ease-out 0s;
}

/* Panel starts lower and slides up into place as the modal fades in. */
.playlists--hidden .playlists__panel {
    translate: 0 40px;
}

.playlists__wings {
    position: absolute;
    top: -60px;
    right: -60px;
    width: var(--playlists-wings-width);
    height: var(--playlists-wings-height);
    rotate: 16deg;
    background-image: url("project://database/Assets/UI/Images/Buttons/Sticker_Wings.png?fileID=21300000&guid=39f9b30023036e54a994c989af0946d0&type=3#Sticker_Wings");
    -unity-background-scale-mode: scale-to-fit;
}

.playlists__close {
    position: absolute;
    top: -22px;
    right: 0px;
    width: var(--playlists-close-size);
    height: var(--playlists-close-size);
    min-width: 32px;
    min-height: 32px;
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Images/Buttons/Button_Close_Light.png?fileID=21300000&guid=48a59ae53f1e43344bcb878a2b6542b9&type=3#Button_Close_Light");
    -unity-background-scale-mode: scale-to-fit;
    transition: scale 0.12s ease-out 0s;
}

.playlists__close:hover {
    scale: 1.08 1.08;
}

.playlists__close:active {
    scale: 0.92 0.92;
}

.playlists__title {
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
    margin-left: var(--spacing-sm);
    font-size: var(--font-size-xl);
    color: var(--color-parchment-heading);
    -unity-font-style: bold;
}

.playlists__grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    padding-left: var(--spacing-sm);
}

.playlists__card {
    margin-left: var(--playlists-card-gap);
    margin-right: var(--playlists-card-gap);
    flex-grow: 0;
    flex-shrink: 0;
}

.playlists__card--first {
    margin-left: 0;
}

.playlists__divider {
    width: 55%;
    height: 2px;
    align-self: center;
    margin-top: auto;
    margin-bottom: var(--spacing-md);
    border-radius: var(--radius-pill);
    background-color: var(--color-parchment-ink-muted);
    opacity: 0.5;
}
