<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/UI/GlobalStyles/Global.uss"/>
    <Style src="/Assets/UI/Screens/Pomodoro/PomodoroButton.uss"/>
    <!-- Full-screen root ignores picking so only the corner button captures input;
         the rest of the screen passes clicks through to the game/other UI. -->
    <ui:VisualElement name="pomodoro-button-root" class="pomodoro-launcher" picking-mode="Ignore">
        <ui:Button name="pomodoro-button" text="Timer" class="pomodoro-launcher__btn btn-banner"/>
    </ui:VisualElement>
</ui:UXML>
